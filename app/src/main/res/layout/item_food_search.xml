<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="14dp"
    app:strokeColor="#2A2A2A"
    app:strokeWidth="1dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="#1AFFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical">

        <!-- Stanga: Nume + Macros -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/foodNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Piept de pui la grătar"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/proteinText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P31"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#64B5F6" />

                <TextView
                    android:id="@+id/carbsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFB74D"
                    android:layout_marginStart="12dp" />

                <TextView
                    android:id="@+id/fatText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="G4"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E57373"
                    android:layout_marginStart="12dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Separator vertical -->
        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="#2E2E2E"
            android:layout_marginHorizontal="16dp" />

        <!-- Dreapta: Calorii centrate vertical -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/caloriesMainText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="165"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvKcalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kcal"
                android:textSize="11sp"
                android:textColor="#4CAF50"
                android:alpha="0.6"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
