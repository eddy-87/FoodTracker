<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_dark_rounded"
    android:paddingHorizontal="28dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp">

    <!-- Accent bar portocaliu -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#FF9800"
        android:layout_marginBottom="22dp"/>

    <!-- Titlu -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Introdu Pașii"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="6dp"/>

    <!-- Subtitlu -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Introdu numărul de pași pentru azi"
        android:textSize="13sp"
        android:textColor="#999999"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <!-- Câmp de input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input_dark"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp"
        android:gravity="center">

        <EditText
            android:id="@+id/etManualSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint=""
            android:inputType="number"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textColorHint="#686868"
            android:gravity="center"
            android:maxLines="1"
            android:importantForAutofill="no"/>
    </LinearLayout>

    <!-- Preview calorii arse (live) -->
    <TextView
        android:id="@+id/tvStepCalPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#FF9800"
        android:gravity="center"
        android:minHeight="36dp"
        android:paddingTop="10dp"/>

    <!-- Butoane -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSteps"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Anulează"
            android:textColor="#999999"
            android:textStyle="bold"
            app:strokeColor="#3D3D3D"
            app:cornerRadius="14dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSteps"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Salvează"
            android:textColor="#121212"
            android:textStyle="bold"
            app:backgroundTint="#FF9800"
            app:cornerRadius="14dp"/>

    </LinearLayout>

</LinearLayout>
