<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dark"
    android:paddingTop="12dp"
    android:paddingBottom="32dp"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#555555"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"/>

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="#1A4CAF50"
                app:cardCornerRadius="14dp"
                app:strokeWidth="0dp"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    app:tint="#4CAF50"
                    android:scaleType="fitCenter"/>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aliment Nou"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completează informațiile nutriționale"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Section label: Info de baza -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INFORMAȚII DE BAZĂ"
            android:textColor="#757575"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="10dp"/>

        <!-- Nume aliment -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_search_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_dinner"
                app:tint="#4CAF50"
                android:alpha="0.8"
                android:layout_marginEnd="12dp"/>

            <EditText
                android:id="@+id/etCustomName"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Nume aliment"
                android:textColor="#FFFFFF"
                android:textColorHint="#686868"
                android:textSize="15sp"
                android:inputType="textCapSentences"
                android:maxLines="1"/>
        </LinearLayout>

        <!-- Unit toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_search_bar"
            android:padding="4dp">

            <RadioGroup
                android:id="@+id/rgUnit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbGrams"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Grame (g)"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:button="@null"
                    android:background="@drawable/bg_unit_tab"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbMl"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Mililitri (ml)"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:button="@null"
                    android:background="@drawable/bg_unit_tab"/>
            </RadioGroup>
        </LinearLayout>

        <!-- Gramaj portie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_search_bar"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_weight"
                app:tint="#FF9800"
                android:alpha="0.8"
                android:layout_marginEnd="12dp"/>

            <EditText
                android:id="@+id/etPortionSize"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Gramaj porție (opțional)"
                android:textColor="#FFFFFF"
                android:textColorHint="#686868"
                android:textSize="15sp"
                android:inputType="number"
                android:maxLines="1"/>
        </LinearLayout>

        <!-- Section label: Nutritie -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NUTRIENȚI / 100G"
            android:textColor="#757575"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="10dp"/>

        <!-- Calorii - card special -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#152515"
            app:cardCornerRadius="16dp"
            app:strokeColor="#1E4A1E"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardBackgroundColor="#2A4CAF50"
                    app:cardCornerRadius="11dp"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp"
                    android:layout_marginEnd="14dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        app:tint="#4CAF50"
                        android:scaleType="fitCenter"/>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calorii"
                        android:textColor="#4CAF50"
                        android:textSize="11sp"
                        android:alpha="0.8"
                        android:layout_marginBottom="2dp"/>

                    <EditText
                        android:id="@+id/etCustomCal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:hint="valoare per 100g/ml"
                        android:textColor="#4CAF50"
                        android:textColorHint="#3A8A3A"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:inputType="number"
                        android:maxLines="1"
                        android:padding="0dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kcal"
                    android:textColor="#2A6A2A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Macro section label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MACRONUTRIENȚI / 100G"
            android:textColor="#757575"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="10dp"/>

        <!-- 3 macro cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="28dp">

            <!-- Proteine -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="14dp"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="#2196F3"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Proteine"
                            android:textColor="#2196F3"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp"/>

                        <EditText
                            android:id="@+id/etCustomProt"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_spinner_dark"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#686868"
                            android:hint="0"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carbohidrati -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="14dp"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="#FF9800"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Carbohidrați"
                            android:textColor="#FF9800"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp"/>

                        <EditText
                            android:id="@+id/etCustomCarb"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_spinner_dark"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#686868"
                            android:hint="0"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Grasimi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="14dp"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:background="#F44336"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Grăsimi"
                            android:textColor="#F44336"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="6dp"/>

                        <EditText
                            android:id="@+id/etCustomFat"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_spinner_dark"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#686868"
                            android:hint="0"
                            android:gravity="center"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Butoane actiune -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/btnCancelCustom"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Anulează"
                android:textColor="#999999"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_btn_cancel"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/btnSaveCustom"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.5"
                android:gravity="center"
                android:text="Salvează"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_btn_add"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
