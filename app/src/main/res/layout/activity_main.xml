<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ======== TOP BAR: Profil | < Data > | Stats ======== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <!-- Profile button -->
                <ImageButton
                    android:id="@+id/btnProfile"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_person"
                    android:background="@drawable/bg_icon_button"
                    android:scaleType="centerInside"
                    android:padding="10dp" />

                <!-- Date navigator centrat -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/btnPrevDay"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_arrow_left"
                        android:background="@drawable/bg_nav_arrow"
                        android:scaleType="centerInside"
                        android:padding="6dp" />

                    <TextView
                        android:id="@+id/textDateDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="Astăzi"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_date_chip"
                        android:paddingHorizontal="20dp"
                        android:layout_marginHorizontal="8dp" />

                    <ImageButton
                        android:id="@+id/btnNextDay"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_arrow_right"
                        android:background="@drawable/bg_nav_arrow"
                        android:scaleType="centerInside"
                        android:padding="6dp" />
                </LinearLayout>

                <!-- Stats button -->
                <ImageButton
                    android:id="@+id/btnStats"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_chart"
                    android:background="@drawable/bg_icon_button"
                    android:scaleType="centerInside"
                    android:padding="10dp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Calorii Consumate"
                        android:textAlignment="center"
                        android:textSize="14sp"
                        android:textColor="@color/text_grey"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/textTotalCalories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 / 2000"
                        android:textAlignment="center"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"/>

                    <ProgressBar
                        android:id="@+id/caloriesProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="20dp"
                        android:max="2000"
                        android:progress="0" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/textProtein"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0g"
                                android:textColor="#2196F3"
                                android:textStyle="bold"
                                android:textSize="18sp"/>
                            <TextView
                                android:id="@+id/labelProtein"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Proteine"
                                android:textColor="#2196F3"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/textCarbs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0g"
                                android:textColor="#FF9800"
                                android:textStyle="bold"
                                android:textSize="18sp"/>
                            <TextView
                                android:id="@+id/labelCarbs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Carbo"
                                android:textColor="#FF9800"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/textFat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0g"
                                android:textColor="#F44336"
                                android:textStyle="bold"
                                android:textSize="18sp"/>
                            <TextView
                                android:id="@+id/labelFat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Grăsimi"
                                android:textColor="#F44336"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ======== CARD PAȘI (Samsung Health / Health Connect) ======== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header: icon + titlu + pași -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            app:cardBackgroundColor="#1AFF9800"
                            app:cardCornerRadius="13dp"
                            app:strokeWidth="0dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_steps"
                                app:tint="#FF9800"
                                android:scaleType="fitCenter"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pași"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_dark"
                            android:layout_marginStart="14dp"/>

                        <TextView
                            android:id="@+id/tvStepsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 / 10.000"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#FF9800"/>

                        <ImageButton
                            android:id="@+id/btnEditSteps"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_edit"
                            android:background="@drawable/bg_nav_arrow"
                            android:scaleType="centerInside"
                            android:padding="6dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="Editează pași manual"/>
                    </LinearLayout>

                    <!-- Progress bar pași -->
                    <ProgressBar
                        android:id="@+id/stepsProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginBottom="12dp"
                        android:max="10000"
                        android:progress="0"
                        android:progressTint="#FF9800"/>

                    <!-- Calorii arse din pași -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Calorii arse"
                            android:textSize="14sp"
                            android:textColor="@color/text_grey"/>

                        <TextView
                            android:id="@+id/tvStepsCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 kcal"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#FF9800"/>
                    </LinearLayout>


                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ======== CARD HIDRATARE ======== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#1E1E1E"
                app:cardCornerRadius="20dp"
                app:strokeColor="#2A2A2A"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header: icon + titlu + cantitate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            app:cardBackgroundColor="#1A2196F3"
                            app:cardCornerRadius="13dp"
                            app:strokeWidth="0dp"
                            app:cardElevation="0dp">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_water_drop"
                                app:tint="#2196F3"
                                android:scaleType="fitCenter"/>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hidratare"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>

                            <TextView
                                android:id="@+id/tvWaterCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 / 2000 ml"
                                android:textSize="13sp"
                                android:textColor="#2196F3"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Progress bar hidratare -->
                    <ProgressBar
                        android:id="@+id/waterProgressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginBottom="20dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#2196F3"
                        android:progressBackgroundTint="#2A2A2A"/>

                    <!-- Butoane containere -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvWaterContainers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipToPadding="false"
                        android:scrollbars="none"
                        android:layout_marginBottom="16dp"/>

                    <!-- Separator -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#242424"
                        android:layout_marginBottom="12dp"/>

                    <!-- Titlu istoric -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ISTORIC"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#757575"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="4dp"/>

                    <!-- Lista istoric -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvWaterHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardBackgroundColor="#1A4CAF50"
                    app:cardCornerRadius="13dp"
                    app:strokeWidth="0dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lunch"
                        app:tint="#4CAF50"
                        android:scaleType="fitCenter"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mesele de Astăzi"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="14dp"/>
            </LinearLayout>

            <!-- Empty state - vizibil cand nu exista alimente -->
            <LinearLayout
                android:id="@+id/emptyFoodState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:cardBackgroundColor="#1E1E1E"
                    app:cardCornerRadius="24dp"
                    app:strokeColor="#2A2A2A"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="20dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lunch"
                        app:tint="#333333"
                        android:scaleType="fitCenter"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nicio masă înregistrată"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apasă Adaugă pentru a începe ziua"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/foodRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/addFoodFab"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="Adaugă"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_add"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#4CAF50"
        app:cornerRadius="28dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>